<Window x:Class="Needle.Screensaver.UI.ConstellationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="False"
        Background="#0B0F1A"
        ShowInTaskbar="False"
        Topmost="True">
    <Grid x:Name="RootGrid" ClipToBounds="True">
        <!-- Fallback dark gradient backdrop -->
        <Rectangle x:Name="FallbackBackdrop">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop x:Name="BackdropStop1" Color="#0D1224" Offset="0" />
                    <GradientStop x:Name="BackdropStop2" Color="#080B17" Offset="1" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- Full-bleed album cover artwork backdrop (high-quality Fant scaling + subtle Gaussian blur to eliminate low-res SMTC thumbnail pixelation) -->
        <Image x:Name="ArtworkImage"
               Stretch="UniformToFill"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               RenderOptions.BitmapScalingMode="HighQuality"
               RenderTransformOrigin="0.5,0.5"
               Opacity="0">
            <Image.RenderTransform>
                <ScaleTransform ScaleX="1.06" ScaleY="1.06" />
            </Image.RenderTransform>
            <Image.Effect>
                <BlurEffect Radius="18" KernelType="Gaussian" RenderingBias="Quality" />
            </Image.Effect>
        </Image>

        <!-- Subtle dark scrim so Stars constellation remains crisp and high-contrast (no edge glow) -->
        <Rectangle x:Name="ScrimOverlay" IsHitTestVisible="False">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#6B000000" Offset="0" />
                    <GradientStop Color="#94000000" Offset="0.5" />
                    <GradientStop Color="#7A000000" Offset="1" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- Stars constellation layer -->
        <Canvas x:Name="StarsCanvas" IsHitTestVisible="False" />

        <!-- Fallback centered track info when no synced lyrics or Spotify idle -->
        <StackPanel x:Name="FallbackPanel"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="Collapsed"
                    Margin="48">
            <TextBlock x:Name="FallbackTitle"
                       FontFamily="Segoe UI Variable Display, Segoe UI"
                       FontSize="30"
                       FontWeight="Bold"
                       Foreground="#9EC7FF"
                       TextAlignment="Center"
                       TextWrapping="Wrap" />
            <TextBlock x:Name="FallbackArtist"
                       FontFamily="Segoe UI Variable Text, Segoe UI"
                       FontSize="18"
                       FontWeight="Medium"
                       Foreground="#B8FFFFFF"
                       TextAlignment="Center"
                       Margin="0,8,0,0" />
        </StackPanel>

        <!-- Subtle bottom track caption -->
        <TextBlock x:Name="TrackCaption"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Bottom"
                   Margin="40,0,40,56"
                   FontFamily="Segoe UI Variable Text, Segoe UI"
                   FontSize="13"
                   FontWeight="Medium"
                   Foreground="#73FFFFFF"
                   TextTrimming="CharacterEllipsis" />
    </Grid>
</Window>
